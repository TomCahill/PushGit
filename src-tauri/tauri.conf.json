{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PushGit",
  "version": "1.3.0",
  "identifier": "dev.pushgit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PushGit",
        "width": 800,
        "height": 600,
        "backgroundColor": "#141218"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "PushGit — a fast, lightweight git GUI with a proper visual commit graph.",
      "args": [
        {
          "name": "repo-path",
          "index": 1,
          "takesValue": true,
          "required": false,
          "description": "Path to a repository to open on launch"
        }
      ]
    }
  }
}
